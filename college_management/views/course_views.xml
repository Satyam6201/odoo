<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Course Form View -->
    <record id="view_college_course_form" model="ir.ui.view">
        <field name="name">college.course.form</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <form string="Course">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="department_id"/>
                        </group>
                        <group>
                            <field name="duration"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Course Tree/List View -->
    <record id="view_college_course_tree" model="ir.ui.view">
        <field name="name">college.course.tree</field>
        <field name="model">college.course</field>
        <field name="arch" type="xml">
            <tree string="Courses">
                <field name="name"/>
                <field name="code"/>
                <field name="department_id"/>
                <field name="duration"/>
            </tree>
        </field>
    </record>

    <!-- Action for Course -->
    <record id="action_college_course" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">college.course</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
