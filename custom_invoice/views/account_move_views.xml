<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_custom_invoice" model="ir.ui.view">
        <field name="name">account.move.form.inherit.custom.invoice</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_reference']" position="after">
                <field name="customer_po_number"/>
            </xpath>
            <xpath expr="//page[@name='other_info']" position="inside">
                <group string="Bank Details">
                    <field name="bank_name"/>
                    <field name="bank_account_number"/>
                    <field name="bank_ifsc_code"/>
                </group>
                <group string="Terms &amp; Conditions">
                    <field name="terms_and_conditions" nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
