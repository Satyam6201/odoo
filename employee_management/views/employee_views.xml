<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee List/Tree View -->
    <record id="view_employee_management_tree" model="ir.ui.view">
        <field name="name">employee.management.tree</field>
        <field name="model">employee.management</field>
        <field name="arch" type="xml">
            <tree string="Employees">
                <field name="name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="adharcard"/> 
                <field name="job_position"/>
                <field name="department_id"/>
                <field name="salary"/>
                <field name="joining_date"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Employee Form View -->
    <record id="view_employee_management_form" model="ir.ui.view">
        <field name="name">employee.management.form</field>
        <field name="model">employee.management</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Employee Name..."/>
                        </h1>
                    </div>
                    <group>
                        <group string="Employee Information">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="adharcard"/>
                        </group>
                        <group string="Job Information">
                            <field name="job_position"/>
                            <field name="department_id"/>
                            <field name="joining_date"/>
                        </group>
                        <group string="Salary Information">
                            <field name="salary"/>
                            <field name="annual_salary"/>
                        </group>
                        <group string="Status">
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Employee Search View -->
    <record id="view_employee_management_search" model="ir.ui.view">
        <field name="name">employee.management.search</field>
        <field name="model">employee.management</field>
        <field name="arch" type="xml">
            <search string="Search Employees">
                <field name="name"/>
                <field name="email"/>
                <field name="department_id"/>
                <field name="job_position"/>
                <separator/>
                <filter string="Active Employees" name="active_employees" domain="[('active', '=', True)]"/>
                <filter string="Inactive Employees" name="inactive_employees" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Job Position" name="group_by_job_position" context="{'group_by': 'job_position'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Employee Action -->
    <record id="action_employee_management" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">employee.management</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_employee_management_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new employee!
            </p>
        </field>
    </record>

    <!-- Menus -->
    <!-- Top Level Menu -->
    <menuitem id="menu_employee_management_root" name="Employee Management" sequence="10"/>

    <!-- Action Menus -->
    <menuitem id="menu_employee_management_employees" 
              name="Employees" 
              parent="menu_employee_management_root" 
              action="action_employee_management" 
              sequence="10"/>

    <menuitem id="menu_employee_management_departments" 
              name="Departments" 
              parent="menu_employee_management_root" 
              action="action_employee_department" 
              sequence="20"/>

</odoo>