<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Department List/Tree View -->
    <record id="view_employee_department_tree" model="ir.ui.view">
        <field name="name">employee.department.tree</field>
        <field name="model">employee.department</field>
        <field name="arch" type="xml">
            <tree string="Departments">
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <!-- Department Form View -->
    <record id="view_employee_department_form" model="ir.ui.view">
        <field name="name">employee.department.form</field>
        <field name="model">employee.department</field>
        <field name="arch" type="xml">
            <form string="Department">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Department Name..."/>
                        </h1>
                    </div>
                    <group>
                        <field name="active" widget="boolean_toggle"/>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Employees">
                            <field name="employee_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="job_position"/>
                                    <field name="salary"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Department Action -->
    <record id="action_employee_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">employee.department</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new department!
            </p>
        </field>
    </record>

</odoo>